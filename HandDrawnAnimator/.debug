<?xml version="1.0" encoding="UTF-8"?>
<!-- Remote-debug ports for development. With PlayerDebugMode enabled, open
     http://localhost:8088 in a Chromium browser to inspect the panel. -->
<ExtensionList>
    <Extension Id="com.yeison.handdrawnanimator.panel">
        <HostList>
            <Host Name="PPRO" Port="8088"/>
        </HostList>
    </Extension>
</ExtensionList>
